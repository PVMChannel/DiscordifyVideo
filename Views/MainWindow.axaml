<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscordifyVideo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DiscordifyVideo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DiscordifyVideo"
        MinWidth="500"
        MinHeight="200">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">
    <TextBlock TextBlock.TextWrapping="Wrap" Grid.Row="0" Text="Copy a video to clipboard, click the convert button, and your 10mb discord-playble video will be copied in your clipboard" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Grid ColumnDefinitions="Auto, Auto" Grid.Row="1" ColumnSpacing="3" HorizontalAlignment="Center">

    <Button Grid.Column="0" HorizontalAlignment="Center" Content="Convert video" Command="{Binding Convert}"/>
    <Button Grid.Column="1" HorizontalAlignment="Center" Content="Delete converted video" Command="{Binding DeleteConvertedVideo}"/>
        </Grid>
<!--Click="Button_OnClick"-->
  <ProgressBar Grid.Row="2" Margin="0 10" Height="20" 
                Minimum="0" Maximum="100" Value="{Binding Progress.AudioConvertionProgress}"
                ShowProgressText="True"/>
    <ProgressBar Grid.Row="3" Margin="0 10" Height="20" 
Minimum="0" Maximum="100" Value="{Binding Progress.VideoConvertionProgress}"
ShowProgressText="True"/>
<ProgressBar Grid.Row="4" Margin="0 10" Height="20" 
Minimum="0" Maximum="100" Value="{Binding Progress.CombiningProgress}"
ShowProgressText="True"/>
</Grid>
</Window>
