<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscordifyVideo.ViewModels"
        x:Class="DiscordifyVideo.Views.FFMpegDownloadProgressDialog"
        x:DataType="vm:FFMpegDownloadProgressDialogViewModel"
        Title="Downloading..."
        Width="200" Height="100"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Downloading FFmpeg..."
                   TextWrapping="Wrap" VerticalAlignment="Center" />
    </Grid>
</Window>